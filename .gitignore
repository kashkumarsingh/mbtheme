# Theme, three custom plugins, and the deploy workflow.
*
!.gitignore
!.github/
!.github/workflows/
!.github/workflows/**
!mbgroupltd/
!mbgroupltd/**
!plugins/
plugins/*
!plugins/custom-quote-form/
!plugins/custom-quote-form/**
!plugins/custom-quote-form-shared/
!plugins/custom-quote-form-shared/**
!plugins/custom-quote-form-wizard/
!plugins/custom-quote-form-wizard/**

# Keep secrets and database dumps out even if they land in the theme folder.
**/.env
**/*.sql
**/wp-config.php
**/*:Zone.Identifier
**/*.backup
